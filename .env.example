# kartavya Phase 9 Public Multi-User Production Environment Variables
# Copy to .env or set in Streamlit Secrets / Cloud Deployment Settings (never commit real .env to git)

# Environment mode: development / production
KARTAVYA_ENV=production

# Deployment Mode:
# "production" -> Public multi-user mode with PostgreSQL + Google OAuth + strict user data isolation
# "local"      -> Local development mode with Dev user switcher and SQLite/JSON storage
KARTAVYA_MODE=production

# Production Database Connection String (PostgreSQL recommended)
DATABASE_URL=postgresql://username:password@localhost:5432/kartavya_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Google OAuth Credentials (for Streamlit st.login / st.user)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Custom data persistence directory (relative or absolute path for local fallback)
KARTAVYA_DATA_DIR=data

# Maximum allowed file upload size in MB (for JSON data restores)
MAX_UPLOAD_SIZE_MB=5

# HTTP API timeout in seconds for daily quote fetching
KARTAVYA_QUOTE_API_TIMEOUT=3.0
