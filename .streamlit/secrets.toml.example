# Streamlit Google OAuth Secrets Configuration Example
# Copy to .streamlit/secrets.toml for Google OAuth login on local/production server

[auth]
redirect_uri = "http://localhost:8501/oauth2callback" # Or your public domain callback URL
cookie_secret = "generate_a_random_32_character_secret_string"

[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[postgres]
url = "postgresql://username:password@localhost:5432/kartavya_db"
